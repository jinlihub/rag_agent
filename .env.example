# Tavily搜索 - 获取API密钥：https://tavily.com/
TAVILY_API_KEY=<your_tavily_api_key>

# Exa搜索 - 获取API密钥：https://exa.ai/，10 美元免费额度/月
EXA_API_KEY=<your_exa_api_key>

# 联网搜索缓存 (可选) - Tavily 与 Exa 共用, 相同 query 在 TTL 内复用结果
# 避免重复计费 (Tavily advanced 每次 2 积分); 仅缓存成功结果, 失败每次重试
# 缓存是进程内的 (同 rate_limiter): 多 worker 部署时各持一份, 只会各自多查一次
WEB_SEARCH_CACHE_TTL=600            # 条目存活秒数
WEB_SEARCH_CACHE_MAX_ENTRIES=512    # 容量上限, 超出先清过期再删最旧一半

