# ===== MySQL 数据底座 =====
DB_HOST=192.168.10.120
DB_PORT=3306
DB_USER=iflytek
DB_PASSWORD=123456
DB_NAME=rag_cleaned

# ===== 对话模型（OpenAI 兼容接口，需支持 function calling）=====
# 例（DeepSeek）: https://api.deepseek.com/v1  /  deepseek-chat
# 例（通义）:     https://dashscope.aliyuncs.com/compatible-mode/v1  /  qwen-max
# 例（智谱）:     https://open.bigmodel.cn/api/paas/v4  /  glm-4.7-flashx
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM 客户端厂商（rag_agent/clients/llm_factory.py）：zai=智谱（默认）/ deepseek=DeepSeek
LLM_PROVIDER=zai

# ===== 向量模型（不填则复用上面的 LLM 配置）=====
# 注意：DeepSeek 不提供 embedding 接口，届时需另配（如通义 text-embedding-v3、智谱 embedding-3）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ===== 应用层 =====
# JWT 签名密钥（首次部署用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
AUTH_SECRET=

# ===== 思考模式（glm-4.5/4.6，默认关闭换响应速度）=====
# 开启后回答更深思但首字延迟明显增加
# LLM_TOOL_THINKING=disabled
# LLM_FINAL_THINKING=disabled
# 其他 OpenAI 兼容端点不认识 thinking 字段时置 0 关闭透传
# LLM_THINKING_PARAM=1
# 前端「深度思考」开关打开时最终作答使用的思考强度（默认 high）：
# 智谱 glm-5.3 系常规走 reasoning_effort；深度模式显式开 thinking 以返回思考过程
# 较早型号没有强度档位，自动映射为 thinking.type=enabled
# LLM_DEEP_THINKING=high
# DeepSeek Chat API 没有 thinking 透传参数：开关打开时把回答模型切到该模型
# 需为支持深度思考的型号；留空则回退 deepseek-reasoner
# DEEPSEEK_THINKING_MODEL=deepseek-reasoner

# ===== 检索重排序（Rerank）=====
# 对知识库向量召回（法条/政策/FAQ）做二次排序，让真正含答案的片段顶到前面
# llm = 用工具轮小模型给候选打分（默认，零新增依赖，单次 ~1.8s）
# api = 专用 rerank 接口（Jina/Cohere/SiliconFlow 风格 POST {BASE_URL}/rerank），需配以下三项
# off = 关闭，维持向量相似度序
# RERANK_BACKEND=llm
# RERANK_BASE_URL=
# RERANK_API_KEY=
# RERANK_MODEL=
# RERANK_TIMEOUT=8
# 注：智谱 /rerank（model=rerank）实测判别度不足（候选分数全 ≈1.0，无关对照 0.92），勿直接接入

# ============================================================================
# 以下内容原样取自 D:\xing\edge\env.example
# ============================================================================

# ============================================================================
# 🧠 LLM
# ============================================================================

# DeepSeek模型 - 获取API密钥：https://platform.deepseek.com/
DEEPSEEK_API_KEY=<your_api_key>

# 智谱模型 - 获取API密钥：https://bigmodel.cn/apikey/platform
ZHIPU_API_KEY=<your_api_key>

# LLM 模型配置
LLM_PROVIDER=deepseek
# 深度思考模型 —— 前端「深度思考」开关打开时回答模型切到它（需支持深度思考的型号）
# 留空则回退本项目默认值 deepseek-reasoner
DEEPSEEK_THINKING_MODEL=deepseek-reasoner
DEEPSEEK_MODEL=deepseek-flash
ZHIPU_THINKING_MODEL=glm-4.7-flashx
ZHIPU_MODEL=glm-4.7-flashx

# ============================================================================
# ✅ 离线评测
# ============================================================================

# 评测判分模型 (LLM-as-Judge, 仅 eval/ 用) — 必须与被测模型不同源!
# 同源判分是自评, Faithfulness/Relevancy 会系统性虚高且没有任何征兆;
# eval 启动时会检测并告警。被测侧跟随 LLM_PROVIDER, 这里是判分侧。
EVAL_JUDGE_PROVIDER=zhipu
EVAL_JUDGE_MODEL=glm-5.3-flash
# 评测数据 (前端 /eval 页) — 三个脚本跑完会把结果写成 JSON 快照供它读取
# 快照含内部测试题库与质量分, 且本应用无鉴权; 对外部署可设 false 关掉三个端点
EVAL_ENABLED=true
# 历史列表最多返回几条 (只限展示, 不会删文件)
EVAL_HISTORY_LIMIT=20
# 智谱 OpenAI 兼容端点 —— 仅 ragas 判分用 (zai-sdk 内置的是同一个地址)
# 国际站请改为 https://api.z.ai/api/paas/v4
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ragas 判分单次生成 token 上限。判分模型先输出大段推理再吐 JSON ——
# 给不够, JSON 被截断 -> 该维度变成「判分失败」, 表现为"某些用例莫名缺分";
# 给超了, API 直接报错, 整条判分挂掉。两头都是静默的。
# 32768 是实测值: 4096 不够 (法条型长回答的 NLI 超限) -> 8192 够离线 12 条
# 用例, 但**在线**真实轮 (715 字回答 × 5 段检索结果) 仍然稳定失败,
# 32768 才稳定通过。代码会按 provider 上限再夹一次 —— deepseek-chat 上限
# 8192, 而判分 key 缺失时会自动回退到它, 不夹的话回退路径会整条不可用。
EVAL_JUDGE_MAX_TOKENS=32768
# ragas 响应磁盘缓存目录 (相对项目根)。代码会按 provider-model 自动分子目录 ——
# 换判分模型即换目录, 不会命中旧模型的分数。留空 = 关闭缓存。
#
# ⚠️ 对"整轮重跑评测"基本没用, 别指望它提速: 判分 prompt 里嵌着 RAG 生成的回答,
# 而回答每轮都重新生成、逐字不同 -> 缓存键轮轮不同, 全程命中不了。
# 实测两次完整评测耗时 710s vs 708s (无差别); 但喂**相同输入**时确实生效
# (26.7s -> 0.0s)。真正有用的场景是: 只改判分侧/换 prompt 后重判同一批回答。
EVAL_RAGAS_CACHE_DIR=.cache/ragas
# ragas 匿名遥测默认开启, 会向 t.explodinggradients.com 上报模型名与调用次数
# (不含正文)。它走 requests, 因而不受本项目 trust_env=False 的代理约定约束。
RAGAS_DO_NOT_TRACK=true

# ============================================================================
# 📝 在线评测
# ============================================================================

# ── 在线评测配置 (可选, **默认关**) ──
# 在真实用户问答上自动打分 (采样 + 点踩必评), 滚动结果接进 /eval 页的实时区块。
#
# ⚠️ 默认关是刻意的, 与 EVAL_ENABLED 的默认开不同 —— 开它有**两重代价**:
#   ① 在生产请求路径上真实消耗判分配额 (每评一轮 = 7 次判分 LLM 调用)
#   ② 把**用户问答正文**发给第三方判分模型 (见 EVAL_JUDGE_PROVIDER)
# 本应用无鉴权, 后者尤其需要显式知情。
#
# ⚠️ 本开关与 EVAL_ENABLED 是**「与」关系**: EVAL_ENABLED=false 时评测端点 404,
#    此时即使这里开着也一律不评 —— 否则后台照烧判分配额, 而产出永远没地方看。
ONLINE_EVAL_ENABLED=false
# 采样率 (0-1)。**点踩不受它限制** —— 用户明确标了坏答案的轮次无条件评。
# 注意: 采样率**只影响判分维度**。工具轨迹/轮次/延迟这些执行维度是全量的 ——
# 它们不调 LLM、不出正文。**想只做线上巡检不想花判分钱就设 0**:
# 执行维度照采 100%, 判分只会在点踩时触发。
ONLINE_EVAL_SAMPLE_RATE=0.1
# **判分结果**的环形缓冲容量 (进程内, 重启即清; 满了丢最旧的)
ONLINE_EVAL_BUFFER_SIZE=200
# **执行记录** (工具轨迹/轮次/延迟) 的环形缓冲容量 —— 必须与上面那个分开!
# 执行维度是**全量采集** (纯计数, 不调 LLM), 判分维度按采样率。共用一个 deque
# 的话, 采样率 0.1 时窗口里只剩约 20 条判分记录 (原先 200 条) —— 判分分辨率
# 掉 10 倍, 而那些是最贵的信号。
ONLINE_EVAL_EXEC_BUFFER_SIZE=500
# 并发上限 = 队列 maxsize, 满了即丢、不排队。
# 注意: 限流器是 HTTP 层的, 保护不了进程内的判分调用 —— 拍小是刻意的
# (单个用户打满 30 次/分钟就会触发 30 轮评测 = 210 次判分调用)。
ONLINE_EVAL_MAX_CONCURRENCY=2
# 单轮在线评测的**总预算**(秒), 三个维度共享 —— 每维拿的是剩余量, 不是各分一份。
# 300 是实测值: 一轮三维在 zhipu/glm-5.3-flash 上约 163s (Faithfulness 124s +
# AnswerRelevancy 32s + ContextRelevance 7s, 输入取真实用户轮),
# 留约 2x 余量吸收判分侧抖动。
# ⚠️ 曾经是 60, 踩了两个叠加的坑: ①Faithfulness 一维就吃光整轮预算, 后两维被
#    跳过、整轮零分、图上一根条都不出; ②判分 HTTP 客户端自带的 120s 超时先于
#    外层触发, 报出来是 Request timed out, 看着像网络故障。**别调回 60**。
# 调小不影响问答延迟: worker 是 daemon 线程, 进程退出不等它。
ONLINE_EVAL_ROUND_TIMEOUT=300

