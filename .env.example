# ============================================================================
# 🔗 API
# ============================================================================

# API服务配置
API_HOST=0.0.0.0
API_PORT=8001

# ============================================================================
# 🔍 可观测性
# ============================================================================

# Langfuse 可观测性 (可选) - 获取API密钥：https://www.langfuse.com/
# 不填 KEY 时整个追踪模块静默禁用, 不影响问答主流程
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# 总开关 (默认 true), 设 false 可强制关闭而不必删 key
LANGFUSE_ENABLED=true
# 是否上报 prompt/answer/工具结果正文; false = 只上报长度与条数, 正文不出本机
LANGFUSE_CAPTURE_CONTENT=true
# 出站超时(秒)
LANGFUSE_TIMEOUT=5
# 采样率 0.0~1.0 (只影响 span 上报, 用户反馈打分不受影响)
LANGFUSE_SAMPLE_RATE=1.0
# 环境标签 (dev / staging / prod), 便于同一项目内分流
LANGFUSE_ENVIRONMENT=dev

# ============================================================================
# 📊 系统监控 (可选)
# ============================================================================

# 资源快照与内存日志缓冲
# 无 NVIDIA 显卡时 GPU 块自动降级为「未检测到」, 不影响其他指标
# 本应用无鉴权; 对外部署若不希望暴露主机资源与日志, 设 MONITOR_ENABLED=false
MONITOR_ENABLED=true
# 资源快照缓存 TTL(秒)
MONITOR_METRICS_TTL=5
# nvidia-smi 是百毫秒级子进程, 单独给更长的 TTL 与超时
MONITOR_GPU_TTL=15
MONITOR_GPU_TIMEOUT=5
# 内存环形缓冲日志: 容量(条) / 单条截断(字符) / 采集级别下限
MONITOR_LOG_CAPACITY=500
MONITOR_LOG_TRUNCATE=500
MONITOR_LOG_LEVEL=INFO
# nvidia-smi 绝对路径 (留空 = 从 PATH 查找)
NVIDIA_SMI_PATH=

# ============================================================================
# 📋 上下文工程
# ============================================================================

# 历史压缩 (可选) - 超窗旧对话 → LLM 摘要 → 注入系统提示
# 只保留最近 MAX_HISTORY_ROUNDS(默认5) 轮, 更早的消息原本直接丢弃,
# 开启后会被摘要成「前情提要」, 让 Agent 仍记得早期说过的项目名称/编号等。
# 摘要缓存在进程内(重启失效, 只重算), 每一层都可降级, 失败等价于不开启。
#
# ⚠️ MAX_HISTORY_ROUNDS **不是环境变量**, 是 src/agent/constants.py 里的常量(默认 5)。
#    把它调大之后, 溢出变少、本功能近乎不触发 —— **这是预期行为, 不是失效**。
HISTORY_COMPRESS_ENABLED=true
# 摘要缓存容量 (会话数), LRU 淘汰
HISTORY_COMPRESS_CACHE_SIZE=128
# 摘要正文上限(字符) —— 最重要的成本旋钮
HISTORY_COMPRESS_MAX_CHARS=600
# 触发阈值: 新增未覆盖的溢出消息数达到几条才真的调 LLM (4 = 2 轮)
HISTORY_COMPRESS_MIN_NEW_MESSAGES=4
# 单次送摘要的原文上限(字符), 超出部分留到下一轮继续消化
HISTORY_COMPRESS_MAX_INPUT_CHARS=4000
# 压缩调用超时(秒); 超时降级为直接截断
HISTORY_COMPRESS_TIMEOUT=15
# 压缩用 provider (留空 = 跟随请求的 provider; 本地模型慢可钉死 deepseek)
HISTORY_COMPRESS_PROVIDER=

# ============================================================================
# PostgreSQL（src/database/to_postgresql.py：xlsx 数据注入本地库）
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# ===== 图片解析（前端附件上传 → /api/vision/parse）=====
# 视觉模型，走 zai SDK（ZhipuAiClient），API Key 复用 LLM_API_KEY
VISION_MODEL=glm-4.6v-flashx

# ===== Tavily 联网搜索（前端"联网搜索"开关 → search_web 工具）=====
# 免费注册 https://tavily.com 领取 Key（免费档 1000 次/月）；留空则联网工具不可用
TAVILY_API_KEY=
TAVILY_TIMEOUT=10

# ===== Exa MCP 联网搜索（标准 MCP server，search_web 的备选搜索引擎）=====
# 官方托管端点 https://mcp.exa.ai/mcp；Key 申请 https://exa.ai/（每月有免费额度）
# 留空则不注册 search_web_exa 工具（工具列表只保留 Tavily）
EXA_API_KEY=
# EXA_MCP_URL=https://mcp.exa.ai/mcp
# EXA_TIMEOUT=15
